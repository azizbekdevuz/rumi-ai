# RUMI AI Frontend Environment Variables
# Copy to .env.local and fill in values. Never commit .env.local.

# Backend API base URL (required)
BACKEND_URL=http://localhost:8000

# Kakao OAuth (required for Kakao login)
KAKAO_REST_API_KEY=
KAKAO_REDIRECT_URI=http://localhost:3003/api/auth/kakao/callback

# Google OAuth (required for Google login)
GOOGLE_CLIENT_ID=
GOOGLE_REDIRECT_URI=http://localhost:3003/api/auth/google/callback
