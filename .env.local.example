# RUMI AI Frontend Environment Variables
# Copy to .env.local and fill in values. Never commit .env.local.

# Backend API base URL (required). Server-side only; never prefix with NEXT_PUBLIC_.
BACKEND_URL=http://localhost:8000

# Public origin of this Next.js app. Leave unset for `pnpm dev`.
# Production must be https and is set in .env.production (see .env.production.example).
# APP_BASE_URL=http://localhost:3003

# Kakao OAuth (required for Kakao login)
KAKAO_REST_API_KEY=
KAKAO_REDIRECT_URI=http://localhost:3003/api/auth/kakao/callback

# Google OAuth (required for Google login)
GOOGLE_CLIENT_ID=
GOOGLE_REDIRECT_URI=http://localhost:3003/api/auth/google/callback
