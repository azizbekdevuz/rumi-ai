# env files (can opt-in for committing if needed)
.env
.env.local

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

weekly reports/
aboutProject/
screenshots/
generate-pdf.md
Weekly_Progress_Report.html
Weekly_Progress_Report.pdf

