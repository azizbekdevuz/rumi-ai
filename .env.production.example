# Interpolation values for docker-compose.prod.yml.
# Copy to .env.production in the repository root and fill in every blank.
# Never commit .env.production.
#
#   cp .env.production.example .env.production
#   chmod 600 .env.production
#
# Compose reads this file only through --env-file. It maps each value into
# the one service that needs it (see docker-compose.prod.yml):
#   docker compose --env-file .env.production -f docker-compose.prod.yml up -d --build
#
# Required values are blank on purpose: Compose refuses to start until they
# are set, so Postgres never initializes its volume with a placeholder.
#
# Generate secrets on the host (hex needs no URL encoding):
#   openssl rand -hex 24    # DB_PASSWORD
#   openssl rand -hex 32    # SECRET_KEY

# Postgres (db) and the API's database connection.
DB_NAME=rumi_ai
DB_USER=rumi_user
DB_PASSWORD=

# API only: JWT signing key, at least 32 characters.
SECRET_KEY=

# Public https origin, no trailing slash.
# APP_BASE_URL -> web (OAuth redirects, cookies). ALLOWED_HOSTS -> API CORS.
APP_BASE_URL=
ALLOWED_HOSTS=

# Header the ingress overwrites with the client IP (web only).
# x-real-ip        -> Caddy with deploy/Caddyfile.example (default)
# cf-connecting-ip -> Cloudflare Tunnel straight to 127.0.0.1:3003
TRUSTED_CLIENT_IP_HEADER=x-real-ip

# Host loopback port for the web container (published on 127.0.0.1 only).
WEB_PORT=3003

# API only: host Ollama via host-gateway.
OLLAMA_BASE_URL=http://host.docker.internal:11434
LLM_API_URL=http://host.docker.internal:11434
LLM_API_KEY=
LLM_MODEL=qwen2.5:3b
EMBED_MODEL=nomic-embed-text:latest

# OAuth. Client IDs and redirect URIs go to web and API.
# Client secrets go to the API only.
# Redirect URIs must be https, start with APP_BASE_URL, and be registered
# with the provider. Leave a provider blank to disable it.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
KAKAO_REST_API_KEY=
KAKAO_CLIENT_SECRET=
KAKAO_REDIRECT_URI=
