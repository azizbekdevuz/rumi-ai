  "translations": [
    {
      "verse_no": 1,
      "translation": "A vast, ancient mountain, its peak shrouded in clouds, / Guarded by unseen spirits, a timeless, silent throne."
    },
    {
      "verse_no": 2,
      "translation": "The wind whispers secrets, through canyons deep and wide."
    },
    {
      "verse_no": 3,
      "translation": "Rivers carve their pathways, a liquid, silver tide. / Where ancient trees stand witness, to ages that have flown."
    },
    {
      "verse_no": 4,
      "translation": "These are the teachings spoken, by nature's gentle tongue. / Listen to the silence, where wisdom is instilled."
    },
    {
      "verse_no": 5,
      "translation": "A journey to the essence, where true light is instilled."
    },
    {
      "verse_no": 6,
      "translation": "The eagle soars in freedom, on currents of the air. / A symbol of the spirit, beyond all worldly care."
    },
    {
      "verse_no": 7,
      "translation": "The eagle, you have noticed, perched upon the mountain's crest. / Gazing at the heavens, where all souls find their rest."
    },
    {
      "verse_no": 8,
      "translation": "A spectrum of colors, a vibrant, wondrous sight. / The dewdrop on the petal, reflecting morning light."
    },
    {
      "verse_no": 9,
      "translation": "Two lovers, in the garden, their hearts begin to bloom. / Two breaths, a single essence, dispelling any gloom."
    },
    {
      "verse_no": 10,
      "translation": "The fortress of perception, where ego starts to fade."
    },
    {
      "verse_no": 11,
      "translation": ""
    },
    {
      "verse_no": 12,
      "translation": "Awakened by the dawn, a stranger to the night. / From the east, the sun arises, with its glorious, golden light."
    },
    {
      "verse_no": 13,
      "translation": ""
    },
    {
      "verse_no": 14,
      "translation": "The garden gate opens, revealing the vast sky. / Where endless possibilities, in gentle breezes lie."
    },
    {
      "verse_no": 15,
      "translation": ""
    }
