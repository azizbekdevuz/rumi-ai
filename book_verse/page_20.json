  "translations": [
    {
      "verse_no": 133,
      "translation": "O King, the door of Thy benevolence is open, O exalted one!"
    },
    {
      "verse_no": 134,
      "translation": "O Prince! He is that King who, by the nature of His dominion, is not bound by the temporal world, nor is He anything but the soul of the world. He is like the sun, which is reflected in a mirror; it is not bound to the mirror, nor is the mirror able to confine it."
    },
    {
      "verse_no": 135,
      "translation": "Is it haste or delay? He says, 'The world is made new, and all the souls are renewed.'"
    },
    {
      "verse_no": 136,
      "translation": "Unaware of the renewal of existence."
    },
    {
      "verse_no": 137,
      "translation": "God, the Exalted, says: 'That which is renewed is My decree and My command.'"
    },
    {
      "verse_no": 138,
      "translation": "The harmony of opposites is the life of the world, O thou who art a seeker of union."
    },
    {
      "verse_no": 139,
      "translation": "A lover cannot rest from loving."
    },
    {
      "verse_no": 140,
      "translation": "The grace of God makes this lioness yield, and gives her healing."
    },
    {
      "verse_no": 141,
      "translation": "That twofold, by means of which the world is made to turn."
    },
    {
      "verse_no": 142,
      "translation": "One is the moon, the other is the sun, one is the shepherd, the other is the flock, one is the lion, the other is the lamb."
    }
  ]
