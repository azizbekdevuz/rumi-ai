      "translation": "Love is the soul of the universe."
    },
    {
      "verse_no": 145,
      "translation": "Love is the divine essence."
    },
    {
      "verse_no": 146,
      "translation": "Love is the divine light."
    },
    {
      "verse_no": 147,
      "translation": "The love of God is in the heart."
    },
    {
      "verse_no": 148,
      "translation": "The love of God is in the soul."
    },
    {
      "verse_no": 149,
      "translation": "The love of God is in the world."
    },
    {
      "verse_no": 150,
      "translation": "The love of God is in all things."
    },
    {
      "verse_no": 151,
      "translation": "The love of God is eternal."
    },
    {
      "verse_no": 152,
      "translation": "The love of God is infinite."
    },
    {
      "verse_no": 153,
      "translation": "The love of God is all-encompassing."
    },
    {
      "verse_no": 154,
      "translation": "The love of God is the greatest gift."
    },
    {
      "verse_no": 155,
      "translation": "The love of God is the path to salvation."
    },
    {
      "verse_no": 156,
      "translation": "The love of God is the key to paradise."
