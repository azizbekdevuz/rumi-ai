  "translations": [
    {
      "verse_no": 1,
      "translation": "The meaning is in these numbers, which are like seeds."
    },
    {
      "verse_no": 2,
      "translation": "They are few, but their branches are many."
    },
    {
      "verse_no": 3,
      "translation": "The number of branches is like the stars."
    },
    {
      "verse_no": 4,
      "translation": "And the leaves are like the sand of the desert."
    },
    {
      "verse_no": 5,
      "translation": "This is a metaphor for the vastness of God's creation."
    },
    {
      "verse_no": 6,
      "translation": "The more you look, the more you see."
    },
    {
      "verse_no": 7,
      "translation": "The more you understand, the more you realize how little you know."
    },
    {
      "verse_no": 8,
      "translation": "This is the path to wisdom."
    },
    {
      "verse_no": 9,
      "translation": "The path is difficult, but the reward is great."
    },
    {
      "verse_no": 10,
      "translation": "Do not be discouraged."
    },
    {
      "verse_no": 11,
      "translation": "Keep going, and you will reach your destination."
    },
    {
      "verse_no": 12,
      "translation": "The destination is a place of peace and enlightenment."
    },
    {
      "verse_no": 13,
      "translation": "This is the ultimate goal of all seekers."
    }
