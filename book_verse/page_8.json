  "translations": [
    {
      "verse_no": 29,
      "translation": "The philosopher says, from the logic of the spheres, intellect emanates from the antechamber."
    },
    {
      "verse_no": 30,
      "translation": "The philosopher who denies the senses is ignorant of the prophets' senses. The speech of water, the speech of the Creator, and the speech of the flower are perceived by the senses of the people of the heart."
    },
    {
      "verse_no": 31,
      "translation": "They brought an elephant into a dark house, and the Hindus had displayed it."
    },
    {
      "verse_no": 32,
      "translation": "People came to see it, but they were all in the dark. Since seeing it with the eyes was not possible, each one began to grope in the darkness."
    },
    {
      "verse_no": 33,
      "translation": "One person's hand fell on its trunk, and he said, 'This is like a water spout.'"
    },
    {
      "verse_no": 34,
      "translation": "It appeared to him like a wind-blown fan."
    },
    {
      "verse_no": 35,
      "translation": "He would describe it wherever he touched it. From their perspective, they all spoke differently."
    },
    {
      "verse_no": 36,
      "translation": "One person gave its leg a thigh. If there had been a candle in each of their hands..."
    },
    {
      "verse_no": 37,
      "translation": "The disagreement would have vanished from their hands."
    },
    {
      "verse_no": 38,
      "translation": "They will hasten to the judge, sit, and say that Jalal al-Din Muhammad did not want the struggles of life from intellect."
    }
