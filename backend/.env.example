# RUMI AI Backend Environment Variables
# Copy to .env and fill in values. Never commit .env.

# Database Configuration
DB_USER=rumi_user
DB_PASSWORD=rumi_password
DB_PORT=5432
DB_NAME=rumi_ai
API_PORT=8000

# Application
APP_ENV=development
DEBUG=false
SECRET_KEY=your-secret-key-here-change-in-production
ALLOWED_HOSTS=localhost,127.0.0.1
# Honor X-Forwarded-For only when the API is reached through the Next.js server.
TRUST_PROXY=false

# LLM (OpenAI-compatible or Ollama)
# Ollama on the host: http://127.0.0.1:11434
# Ollama from the API container: http://host.docker.internal:11434
LLM_API_KEY=
LLM_API_URL=http://127.0.0.1:11434
LLM_MODEL=qwen2.5:3b
USE_MOCK=false

# RAG embeddings (Ollama). Must match a model you have pulled.
OLLAMA_BASE_URL=http://127.0.0.1:11434
EMBED_MODEL=nomic-embed-text:latest
# Empty uses <repo>/book_verse when the API runs on the host.
BOOK_VERSE_DIR=

# Full URL used by the API and Alembic when you run them on the host.
DATABASE_URL=postgresql://rumi_user:rumi_password@localhost:5432/rumi_ai

# JWT
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24

# Rate Limiting
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=60

# Redis (optional, for caching)
REDIS_URL=redis://localhost:6379/0

# Kakao OAuth (required for Kakao login)
KAKAO_REST_API_KEY=
KAKAO_CLIENT_SECRET=
KAKAO_REDIRECT_URI=http://localhost:3003/api/auth/kakao/callback

# Google OAuth (required for Google login)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3003/api/auth/google/callback
