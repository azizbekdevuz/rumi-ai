# RUMI AI Backend Environment Variables
# Copy to .env and fill in values. Never commit .env.

# Database Configuration
DB_USER=rumi_user
DB_PASSWORD=rumi_password
DB_PORT=5432
DB_NAME=rumi_ai

# API Configuration
API_PORT=8000
DEBUG=False
SECRET_KEY=your-secret-key-here-change-in-production
ALLOWED_HOSTS=localhost,127.0.0.1

# LLM (OpenAI-compatible or Ollama)
LLM_API_KEY=
LLM_API_URL=https://api.openai.com/v1/chat/completions
LLM_MODEL=gpt-4
USE_MOCK=false

# Application
DEBUG=false

# JWT
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24

# Rate Limiting
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=60

# Redis (optional, for caching)
REDIS_URL=redis://localhost:6379/0

# Kakao OAuth (required for Kakao login)
KAKAO_REST_API_KEY=
KAKAO_CLIENT_SECRET=
KAKAO_REDIRECT_URI=http://localhost:3003/api/auth/kakao/callback

# Google OAuth (required for Google login)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3003/api/auth/google/callback
